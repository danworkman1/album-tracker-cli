# Spotify Developer Credentials
# Get these by creating an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
# Optional. The CLI uses PKCE, so local users do not need a client secret.
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Google Calendar Credentials
# Get these by creating an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Ensure the authorized redirect URI is set to http://localhost:8889/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
